# Copy to .env and fill in. Only GROQ_API_KEY is required.

# Required for LLM-quality summaries and audio transcription.
# Without it Grayler falls back to a local extractive summarizer.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides -------------------------------------------------------

# API port (default 3001)
PORT=3001

# Summarization model (default llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Transcription model (default whisper-large-v3-turbo)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Max characters accepted by /api/summarize (default 60000)
MAX_INPUT_CHARS=60000

# Max decoded audio bytes accepted by /api/transcribe (default 8388608)
MAX_AUDIO_BYTES=8388608

# Upstream request timeout in milliseconds (default 60000)
REQUEST_TIMEOUT_MS=60000

# Comma-separated allowed CORS origins. Leave blank to allow any origin, which
# is convenient for local development and preview deployments.
ALLOWED_ORIGINS=